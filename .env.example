# Supabase — https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (local or production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Analytics 4 — https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sunucu şablonu: .env.production.example → sunucuda .env.local olarak kopyala

# Cloudflare R2 — https://dash.cloudflare.com/
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-key
CLOUDFLARE_R2_BUCKET_NAME=zippr-ink
CLOUDFLARE_R2_PUBLIC_URL=https://your-r2-public-domain.com

# Cron cleanup (generate a random string)
CRON_SECRET=your-random-cron-secret

# Tosla Payment Gateway
TOSLA_MERCHANT_ID=your-merchant-id
TOSLA_MERCHANT_KEY=your-merchant-key
TOSLA_API_URL=https://api.tosla.com/v1
TOSLA_CALLBACK_URL=http://localhost:3000/api/payments/tosla/webhook
TOSLA_WEBHOOK_SECRET=your-webhook-secret

# Super Admin — set your email in Supabase after first login:
# UPDATE profiles SET role = 'super_admin' WHERE email = 'your@email.com';
