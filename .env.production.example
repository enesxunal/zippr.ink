# =============================================================================
# SUNUCU: Bu dosyayı kopyala → /var/www/zippr.ink/.env.local
# Mac'teki .env.local değerlerini buraya yapıştır; sadece APP_URL ve CALLBACK production olsun.
# =============================================================================
#
# Sunucuda:
#   cd /var/www/zippr.ink
#   cp .env.production.example .env.local
#   nano .env.local
#
# =============================================================================

# --- Supabase (Dashboard → Project Settings → API) ---
# Supabase Dashboard → Project Settings → API → Project URL (xxxxxxx yerine GERÇEK id)
NEXT_PUBLIC_SUPABASE_URL=https://BURAYA_PROJE_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Site adresi (canlı domain) ---
NEXT_PUBLIC_APP_URL=https://zippr.ink

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-8DNKL2V13M

# Sentry (panelden Copy DSN)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=zippr-uj
SENTRY_PROJECT=javascript-nextjs

# --- Cloudflare R2 ---
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=zippr-ink
CLOUDFLARE_R2_PUBLIC_URL=https://XXXXXXXX.r2.dev

# --- Cron (rastgele uzun şifre) ---
CRON_SECRET=

# --- Tosla (opsiyonel; admin panelden de girilebilir) ---
TOSLA_CLIENT_ID=
TOSLA_API_USER=
TOSLA_API_PASSWORD=
TOSLA_MERCHANT_KEY=
TOSLA_API_URL=https://entegrasyon.tosla.com/api/Payment/
TOSLA_CALLBACK_URL=https://zippr.ink/api/payments/tosla/webhook
TOSLA_TEST_MODE=false

# Eski isimler (varsa Mac .env.local'den kopyala):
# TOSLA_MERCHANT_ID=
# TOSLA_WEBHOOK_SECRET=
